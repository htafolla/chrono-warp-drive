# Dynamo MCP write lock. The owner sets these in the host environment.
# Do not commit real values.

# Server-only HMAC-SHA256 key over containerHash|containerId.
# POST /vortex/mint fails closed when this is unset.
# VORTEX_SIGNING_KEY=

# Bearer token required on /vortex/persist, /vortex/mint, /dev/seed-containers,
# and /govern_with_solar when persistToChain is true.
# Fail closed when unset. Read-only governance does not use this key.
# MCP_WRITE_API_KEY=
