# Dynamo MCP write lock. The owner sets these in the host environment.
# Do not commit real values.

# Server-only HMAC-SHA256 key over containerHash|containerId|recipient|expiresAt.
# POST /vortex/mint fails closed when this is unset.
# VORTEX_SIGNING_KEY=

# Bearer token required on /vortex/persist, /vortex/mint, /dev/seed-containers,
# and /govern_with_solar when persistToChain is true.
# Fail closed when unset. Read-only governance does not use this key.
# MCP_WRITE_API_KEY=

# Global mint budget across every caller (HTTP mint and auto-mint). Default 10.
# 0 blocks every mint. Invalid values fall back to 10.
# The per-address cap is separate and is not this protection.
# MINT_GLOBAL_BUDGET=10

# Window for MINT_GLOBAL_BUDGET in milliseconds. Default 60000.
# 0 and other invalid values fall back to 60000.
# MINT_GLOBAL_WINDOW_MS=60000
