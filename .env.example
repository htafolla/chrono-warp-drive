# =============================================================================
# Chrono Warp Drive (Dynamo) — P0.1 platform env mesh
# =============================================================================
# Contract SSOT: ~/dev/0x0/docs/0x0-platform-contract.md
# P0.4 will centralize UI/MCP constants to read DYNAMO_MCP_URL from here.
# =============================================================================

# -----------------------------------------------------------------------------
# Platform contract (cross-repo)
# -----------------------------------------------------------------------------

# Dynamo MCP base URL — SSOT for governance + HTTP MCP harness.
DYNAMO_MCP_URL=https://mcp-production-80e2.up.railway.app

# 0xRay xray-governance MCP (omit endpoint_url in .xray/features.json).
# GOVERNANCE_ENDPOINT=https://mcp-production-80e2.up.railway.app/governance

# 0xRay consumer project root (optional — defaults to MCP cwd).
# XRAY_ROOT=/path/to/chrono-warp-drive

# Repertoire provider (memory_routing in .xray/features.json).
# REPERTOIRE_ROOT=/path/to/repertoire

# -----------------------------------------------------------------------------
# Dynamo UI / neural fusion (chrono-specific — P0.4 SSOT)
# -----------------------------------------------------------------------------

# NEURAL_FUSION_URL=https://neural-fusion-backend-production.up.railway.app
# STELLAR_MCP_URL=https://stellar-mcp-production.up.railway.app

# -----------------------------------------------------------------------------
# Dynamo MCP write lock (owner sets these; never commit real values)
# -----------------------------------------------------------------------------

# Server-only HMAC-SHA256 key. The MCP signs each vortex it produces over
# containerHash|containerId|recipient|expiresAt.
# POST /vortex/mint rejects every request when this is unset.
# VORTEX_SIGNING_KEY=

# Bearer token for chain-write routes: /vortex/persist, /vortex/mint,
# /dev/seed-containers, and /govern_with_solar when persistToChain is true.
# Those routes fail closed when this is unset. Read-only governance stays open.
# The DynamoDeploy chain-save proxy (api/govern-chain, Vercel) reads this same
# name from the host environment and attaches it server-side. Do not prefix it
# with VITE_ or NEXT_PUBLIC_. There is no Railway service in front of the UI.
# MCP_WRITE_API_KEY=

# Comma-separated browser origins allowed to call the chain-save proxy.
# Defaults to https://dynamo.rippel.ai and https://dynamo-ui-psi.vercel.app.
# CHAIN_SAVE_ALLOWED_ORIGINS=

# Global mint budget: how many chain mint writes (HTTP mint and auto-mint together)
# are allowed inside one window, across every caller. This is the wallet protection.
# The per-address cap is extra and is not this budget, because callers choose `to`.
# Default 10. Set 0 to block every mint. Invalid values fall back to 10.
# MINT_GLOBAL_BUDGET=10

# Sliding window for MINT_GLOBAL_BUDGET, in milliseconds. Default 60000.
# 0 and other invalid values fall back to 60000.
# MINT_GLOBAL_WINDOW_MS=60000

# -----------------------------------------------------------------------------
# Contracts / deploy (see contracts/.env.example for chain keys)
# -----------------------------------------------------------------------------